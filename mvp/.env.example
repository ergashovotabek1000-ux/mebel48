# ── Telegram Bot ─────────────────────────────────────────────────────────────
# BotFather dan oling: /newbot
BOT_TOKEN=7xxxxxxxxx:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Operator guruhi ID (manfiy raqam: -100xxxxxxxxxx)
# Guruh ID ni olish: @userinfobot ni guruhga qo'shing
OPERATOR_GROUP_ID=-100xxxxxxxxxx

# ── Supabase ──────────────────────────────────────────────────────────────────
# supabase.com > Project Settings > API
SUPABASE_URL=https://xxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.xxxx

# ── Mini App ──────────────────────────────────────────────────────────────────
# Mini App joylashtirilgan URL (GitHub Pages, Vercel yoki Netlify)
# BotFather da: /newapp → Web App URL shu bo'ladi
MINIAPP_URL=https://your-username.github.io/mebel48-miniapp

# Mini App uchun Supabase (vite build uchun .env fayl kerak)
# miniapp/.env ga yozing:
# VITE_SUPABASE_URL=https://xxxxxxxxxxx.supabase.co
# VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# ── Webhook (faqat production uchun) ─────────────────────────────────────────
# Railway deploy bo'lgach: https://your-app.railway.app
# Lokaldagi ishga tushirish uchun bu qatorni o'chirib qo'ying (polling ishlatadi)
WEBHOOK_URL=https://your-app.railway.app

# Webhook himoyasi uchun tasodifiy string (openssl rand -hex 32)
WEBHOOK_SECRET=your_random_secret_here

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000
